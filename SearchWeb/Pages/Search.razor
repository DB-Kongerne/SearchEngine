@page "/search"
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using SearchAPI
@inject SearchLogic SearchLogic
@implements IDisposable

<!-- Search Engine Page -->

<div class="search-container">
    <div class="search-header text-center mb-5">
        <h1><i class="oi oi-magnifying-glass me-2"></i>Document Search Engine</h1>
        <p class="lead">Search for documents in our database</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="input-group mb-3">
                        <input @bind="searchQuery" @bind:event="oninput" @onkeydown="async (e) => await HandleKeyDown(e)" 
                               type="text" class="form-control form-control-lg" 
                               placeholder="Enter search terms..." aria-label="Search terms">
                        <button class="btn btn-primary btn-lg" @onclick="async () => await ExecuteSearch()">
                            <i class="oi oi-magnifying-glass me-1"></i> Search
                        </button>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="caseSensitiveSwitch" 
                                   @onchange="(e) => ToggleCaseSensitivity(e.Value != null && (bool)e.Value)" checked="@caseSensitive">
                            <label class="form-check-label" for="caseSensitiveSwitch">Case Sensitive</label>
                        </div>
                        <small class="text-muted">Press Enter to search</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger shadow-sm mt-4" role="alert">
        <i class="oi oi-warning me-2"></i> @errorMessage
    </div>
}

<div class="search-results mt-5">
    @if (isSearching)
    {
        <div class="d-flex flex-column justify-content-center align-items-center py-5">
            <div class="spinner-border mb-3" role="status" style="width: 3rem; height: 3rem;">
                <span class="visually-hidden">Searching...</span>
            </div>
            <p>Searching documents...</p>
        </div>
    }
    else if (searchResult != null)
    {
        <div class="card shadow-sm">
            <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
                <h3 class="mb-0">Search Results</h3>
                <span class="badge bg-secondary">@searchResult.Hits documents found</span>
            </div>
            <div class="card-body">
                <div class="d-flex justify-content-between mb-3">
                    <p>Query: <strong>"@string.Join(" ", searchResult.Query)"</strong></p>
                    <p>Time: <span class="text-success">@searchResult.TimeUsed.TotalMilliseconds.ToString("F1") ms</span></p>
                </div>
                
                @if (searchResult.Ignored.Count > 0)
                {
                    <div class="alert alert-warning" role="alert">
                        <i class="oi oi-info me-2"></i> Ignored terms: <strong>@string.Join(", ", searchResult.Ignored)</strong>
                    </div>
                }
                
                @if (searchResult.DocumentHits.Count == 0)
                {
                    <div class="text-center py-5">
                        <i class="oi oi-file" style="font-size: 3rem; opacity: 0.3;"></i>
                        <h4 class="mt-3">No documents found</h4>
                        <p class="text-muted">Try different search terms or check your spelling</p>
                    </div>
                }
                else
                {
                    <div class="list-group">
                        @foreach (var doc in searchResult.DocumentHits)
                        {
                            <div class="list-group-item border-start border-4 @(doc.NoOfHits > 1 ? "border-success" : "border-warning")">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <h5 class="mb-1 text-break">
                                            <i class="oi oi-document me-2"></i>
                                            @doc.Document.mUrl
                                        </h5>
                                        <div class="d-flex align-items-center mb-2">
                                            <span class="badge bg-primary me-2">@doc.NoOfHits hits</span>
                                            <small class="text-muted">Indexed: @doc.Document.mIdxTime</small>
                                        </div>
                                        @if (doc.Missing.Count > 0)
                                        {
                                            <small class="d-block text-muted">
                                                <i class="oi oi-warning me-1"></i>
                                                Missing terms: @string.Join(", ", doc.Missing)
                                            </small>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    private string searchQuery = string.Empty;
    private global::Shared.SearchResult? searchResult;
    private bool isSearching = false;
    private bool caseSensitive = true;
    private string errorMessage = string.Empty;
    private DotNetObjectReference<Search>? objRef;
    
    [Inject]
    public IJSRuntime JSRuntime { get; set; } = default!;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            objRef = DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("initializeDotnetReference", objRef);
        }
    }

    [JSInvokable]
    public async Task ExecuteSearch()
    {
        if (string.IsNullOrWhiteSpace(searchQuery))
            return;

        errorMessage = string.Empty;
        isSearching = true;

        try
        {
            var query = searchQuery.Split(' ', StringSplitOptions.RemoveEmptyEntries);
            searchResult = await Task.Run(() => SearchLogic.Search(query, 10));
        }
        catch (Exception ex)
        {
            errorMessage = $"Search error: {ex.Message}";
        }
        finally
        {
            isSearching = false;
            StateHasChanged();
        }
    }

    [JSInvokable]
    public void ToggleCaseSensitivity(bool value)
    {
        caseSensitive = value;
        SearchLogic.SetCaseSensitivity(value);
        StateHasChanged();
    }

    public async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await ExecuteSearch();
        }
    }

    public void Dispose()
    {
        objRef?.Dispose();
    }
}
