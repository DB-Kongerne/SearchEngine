@page "/"

<!-- Document Search Engine - Home -->

<div class="text-center mt-5">
    <div class="display-1 mb-4">
        <i class="oi oi-document" style="color: var(--yellow-dark);"></i>
    </div>
    <h1 class="display-4 fw-bold mb-4">Document Search Engine</h1>
    <p class="lead mb-5">
        A powerful search engine for finding documents across databases.
        <br>Built with modern technology and optimized for fast results.
    </p>

    <div class="row justify-content-center mt-5">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow">
                <div class="card-body text-start p-4">
                    <h2 class="card-title fw-bold">Get Started</h2>
                    <p class="card-text">
                        Our search engine allows you to quickly find documents across multiple databases.
                        Use the search page to start exploring the document collection.
                    </p>
                    <hr>
                    <div class="d-grid gap-2 d-md-flex justify-content-md-start">
                        <a href="/search" class="btn btn-primary btn-lg px-4 me-md-2">
                            <i class="oi oi-magnifying-glass me-2"></i> Start Searching
                        </a>
                    </div>
                </div>
            </div>

            <div class="card shadow mt-4">
                <div class="card-body">
                    <h5 class="card-title">Features</h5>
                    <ul class="list-unstyled">
                        <li class="mb-2"><i class="oi oi-check text-success me-2"></i> Fast document indexing</li>
                        <li class="mb-2"><i class="oi oi-check text-success me-2"></i> Case sensitive search options
                        </li>
                        <li class="mb-2"><i class="oi oi-check text-success me-2"></i> Multiple database support
                            (SQLite, PostgreSQL)</li>
                        <li class="mb-2"><i class="oi oi-check text-success me-2"></i> Fast response times</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<footer class="footer mt-5">
    <div class="container">
        <p>Document Search Engine - @DateTime.Now.Year</p>
    </div>
</footer>
