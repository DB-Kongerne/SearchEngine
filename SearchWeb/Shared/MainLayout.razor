@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Web

<!-- Document Search Engine -->

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <a href="/search">
                <i class="oi oi-magnifying-glass me-1"></i>
                Search
            </a>
            <a href="https://github.com/DB-Kongerne/SearchEngine" target="_blank">
                <i class="oi oi-code me-1"></i> GitHub
            </a>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>
